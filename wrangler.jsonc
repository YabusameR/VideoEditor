{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "videoeditor",
  "compatibility_date": "2026-10-01",
  // `wrangler deploy` builds first, so Workers Builds works even with an empty
  // build command in the dashboard.
  "build": {
    "command": "npm run build"
  },
  // Static SPA: no Worker script, Cloudflare serves the Vite build directly.
  "assets": {
    "directory": "./dist",
    // Deep links (/editor/<id>, /projects/new …) fall back to index.html.
    "not_found_handling": "single-page-application"
  },
  // Required by `wrangler preview`, which Workers Builds runs for non-production
  // branches (PR previews). Empty: previews inherit the top-level settings.
  "previews": {},
  "routes": [
    {
      "pattern": "videoedit.vvil.jp",
      "custom_domain": true
    }
  ]
}
